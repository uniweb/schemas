{
  "name": "@uniweb/schemas",
  "version": "0.2.13",
  "description": "The Uniweb data-schema format, its standard schema definitions, and the standard section families",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./families": "./src/families.js",
    "./families.json": "./src/families.json",
    "./format": "./src/format.js",
    "./conform": "./src/conform.js",
    "./editor-form": "./src/editor-form.js",
    "./standard/*": "./src/standard/*.js",
    "./utils/*": "./src/utils/*.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "gen:families": "node scripts/gen-families-json.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  },
  "keywords": [
    "uniweb",
    "schemas",
    "content",
    "structured-data"
  ],
  "author": "Uniweb",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/schemas.git"
  },
  "bugs": {
    "url": "https://github.com/uniweb/schemas/issues"
  },
  "homepage": "https://github.com/uniweb/schemas#readme"
}
