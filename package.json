{
  "name": "@uniweb/schemas",
  "version": "0.3.4",
  "description": "The Uniweb data-schema format, its standard schema definitions, and the standard section families and site tags",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./families": "./src/families.js",
    "./families.json": "./src/families.json",
    "./family-aliases": "./src/family-aliases.js",
    "./site-tags": "./src/site-tags.js",
    "./site-tags.json": "./src/site-tags.json",
    "./locales/*": "./src/locales/*.json",
    "./format": "./src/format.js",
    "./conform": "./src/conform.js",
    "./content": "./src/content.js",
    "./editor-form": "./src/editor-form.js",
    "./starter": "./src/starter.js",
    "./standard/*": "./src/standard/*.js",
    "./utils/*": "./src/utils/*.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "gen:vocabulary": "node scripts/gen-vocabulary.mjs"
  },
  "devDependencies": {
    "@uniweb/content-reader": "workspace:*",
    "@uniweb/semantic-parser": "workspace:*",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "uniweb",
    "schemas",
    "content",
    "structured-data"
  ],
  "author": "Uniweb",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/schemas.git"
  },
  "bugs": {
    "url": "https://github.com/uniweb/schemas/issues"
  },
  "homepage": "https://github.com/uniweb/schemas#readme"
}
